{
	"name": "tibreader-desktop",
	"productName": "TibReader",
	"version": "0.1.0",
	"private": true,
	"description": "Open Acronis True Image backups and copy your files out",
	"license": "MIT",
	"author": {
		"name": "prasadvagdargi",
		"url": "https://github.com/prasadvagdargi"
	},
	"homepage": "https://github.com/prasadvagdargi/tibreader#readme",
	"main": "out/main/index.js",
	"engines": {
		"node": ">=22.12"
	},
	"scripts": {
		"dev": "electron-vite dev",
		"build": "electron-vite build",
		"start": "electron-vite preview",
		"typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
		"test:e2e": "electron-vite build && playwright test",
		"fetch-rclone": "node scripts/fetch-rclone.mjs",
		"icon": "electron scripts/render-icon.cjs",
		"dist": "node scripts/fetch-rclone.mjs && electron-vite build && electron-builder --publish never"
	},
	"dependencies": {
		"adler-32": "1.3.1",
		"xml2js": "0.6.2"
	},
	"devDependencies": {
		"@fluentui/react-components": "9.74.9",
		"@fluentui/react-icons": "2.0.344",
		"@playwright/test": "1.64.0",
		"@tanstack/react-virtual": "3.14.19",
		"@types/node": "24.19.2",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@types/xml2js": "0.4.14",
		"@vitejs/plugin-react": "5.2.0",
		"electron": "44.7.1",
		"electron-builder": "26.17.0",
		"electron-vite": "5.0.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"typescript": "7.0.2",
		"vite": "7.3.7"
	}
}
