{
	"name": "tibreader",
	"version": "0.1.0",
	"private": true,
	"description": "Read, verify, extract and mount Acronis True Image (.tib) backups",
	"license": "MIT",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"bin": {
		"tib": "dist/cli.js"
	},
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc -p tsconfig.test.json --noEmit",
		"pretest": "tsc -p tsconfig.test.json",
		"test": "node --test \"build/test/**/*.test.js\""
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/prasadvagdargi/tibreader.git"
	},
	"homepage": "https://github.com/prasadvagdargi/tibreader#readme",
	"bugs": {
		"url": "https://github.com/prasadvagdargi/tibreader/issues"
	},
	"author": {
		"name": "prasadvagdargi",
		"url": "https://github.com/prasadvagdargi"
	},
	"contributors": [
		{
			"name": "Dennis Shtatnov",
			"url": "https://github.com/dennisss"
		}
	],
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"dependencies": {
		"adler-32": "^1.3.1",
		"xml2js": "^0.6.2"
	},
	"devDependencies": {
		"@types/node": "^24.19.2",
		"@types/xml2js": "^0.4.14",
		"typescript": "^7.0.2"
	}
}
